{
  "name": "myfarmtwin-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test game/tests/*.test.mjs",
    "lint": "node tools/check.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "e2e": "node tools/unified-3d-regression.mjs",
    "smoke": "node tools/unified-3d-only-e2e.mjs",
    "preview": "node tools/serve.mjs",
    "compat": "node tools/unified-mobile-layout-e2e.mjs",
    "audit:client": "node tools/audit-client.mjs",
    "balance": "node tools/balance.mjs",
    "endurance": "node tools/long-session.mjs",
    "performance": "node tools/unified-feasibility.mjs",
    "seo": "node tools/seo-e2e.mjs",
    "security": "node tools/security-e2e.mjs",
    "integrity": "node tools/live-integrity.mjs",
    "homepage": "node --check dist/home-promo-v3.js && node tools/homepage-e2e.mjs",
    "chicken": "node tools/unified-chicken-parity-e2e.mjs",
    "homepage:cache": "node tools/homepage-cache-e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
